# Unreal Engine build artifacts and caches — all regenerated automatically,
# none of this is source. Standard exclusions for a UE5 project.
Binaries/
Intermediate/
DerivedDataCache/
Saved/
*.pdb

# Editor/IDE cruft
.vs/
.vscode/
*.sln
*.suo

# OS cruft
Thumbs.db
.DS_Store

# Cook/package bookkeeping, regenerated on every build.
Build/**/FileOpenOrder/*.log

# worker/ (the optional online-room server): installed deps and local
# wrangler state, neither of which is source. package-lock.json IS kept, for
# a reproducible `npm install`.
worker/node_modules/
worker/.wrangler/
